# MongoDB Atlas connection string (M0, Mumbai) from Atlas > Connect > Drivers
MONGODB_URI=
# Database name
MONGODB_DB=vericert
# Auth.js signing secret; generate with: openssl rand -base64 32
AUTH_SECRET=
# Public base URL of the app (http://localhost:3000 locally, the Vercel URL in deploys)
AUTH_URL=
# Google OAuth client ID (Google Cloud Console > Credentials)
AUTH_GOOGLE_ID=
# Google OAuth client secret
AUTH_GOOGLE_SECRET=
# Resend API key for verification and reset emails
RESEND_API_KEY=
# From address for transactional email (Resend test domain until a domain is verified)
EMAIL_FROM=
# Only emails ending in exactly @<this domain> may sign in
ALLOWED_EMAIL_DOMAIN=pict.edu
# Comma-separated admin emails
ADMIN_EMAILS=
# Max /api/verify calls per user per minute
RATE_LIMIT_VERIFY_PER_MIN=60
# Days before runs and results are deleted by TTL index
RESULT_RETENTION_DAYS=180
# Local only: the Preview's "Protection Bypass for Automation" secret, used by `npm run smoke:nptel`
# when testing a Vercel Preview. Never set in Vercel; never commit it.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Local only: a real session cookie for `npm run smoke:nptel --base-url=...` (since Phase 5 /api/verify needs a signed-in user).
# Format: __Secure-authjs.session-token=<value>. See README "Refreshing SMOKE_SESSION_COOKIE". Never set in Vercel; never commit it.
SMOKE_SESSION_COOKIE=
# Local/test only: 1 writes verification and reset emails to tmp/mail-outbox.jsonl instead of sending them.
# Ignored (refused) when NODE_ENV=production or on Vercel. Playwright sets it for its own server.
AUTH_EMAIL_STUB=
